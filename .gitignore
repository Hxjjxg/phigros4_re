# ── 目标 APK（3.33 GB，永不入库）────────────────────────────────
Phigros_*.apk
*.apk
*.xapk

# ── 逆向工具二进制（自行下载，见 tools/README.md）──────────────
tools/jadx-*/
tools/*.jar
tools/*.exe

# ── 从 APK 提取的原始件 + IL2CPP 大中间产物 ────────────────────
# 全部可由 build.ps1 从 APK 重生成，不入库
work/
*.so
*.dylib
*.dll
global-metadata.dat

# jadx 反编译输出：仅本地分析使用，保留 java/README.md 与手写 Java
/java/sources/

# Python 缓存和 Java 编译中间产物
__pycache__/
*.py[cod]
*.class

# ── 构建中间产物（最终 dex 会入库，中间目录不入）───────────────
network/ws/build/

# ── 日志与临时文件 ─────────────────────────────────────────────
*.log
*.tmp
out/

# ── 编辑器 / 系统 ──────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
